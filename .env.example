# Copy to .env to override defaults. Docker Compose loads .env automatically.
# Export it into the current shell before running the host producer.
KAFKA_HOST_PORT=9092
KAFKA_ADVERTISED_HOST=127.0.0.1
# Optional explicit override for the host producer:
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_DOCKER_BOOTSTRAP=kafka:29092
KAFKA_TOPIC1=topic1
KAFKA_TOPIC2=topic2
LOGSTASH_KAFKA_GROUP=cs4371-entity-indexer

ELASTICSEARCH_HOST_PORT=9200
ELASTICSEARCH_HEAP_SIZE=512m
ELASTICSEARCH_DOCKER_URL=http://elasticsearch:9200
ELASTICSEARCH_ENTITY_INDEX=named-entities
KIBANA_HOST_PORT=5601
KIBANA_DOCKER_URL=http://kibana:5601
LOGSTASH_CONFIG_DIR=./part1
LOGSTASH_CONFIG_FILE=logstash.conf

HN_API_BASE_URL=https://hacker-news.firebaseio.com/v0
HN_BACKFILL_ITEMS=3000
HN_POLL_SECONDS=10
HN_FETCH_WORKERS=16
HN_HTTP_TIMEOUT_SECONDS=10
COLLECTED_MESSAGES_PATH=outputs/collected_messages.jsonl
